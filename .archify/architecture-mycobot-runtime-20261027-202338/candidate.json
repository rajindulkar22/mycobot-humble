  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path",
      "items": [
        "Operator posts one cap color to the pick page",
        "YOLO names the cap; the affine fit turns that pixel into a tool pose",
        "The wrist camera nudges the descent, then the gripper closes",
        "The laptop reads one note crop and the driver opens on that note"
      ]
    },
    {
      "dot": "amber",
      "title": "Not on this path",
      "items": [
        "MoveIt plans only; it does not execute",
        "RViz mirrors joint_states and does not command the arm",
        "The card homography feeds the preview, not the pick"
      ]
    },
    {
      "dot": "rose",
      "title": "Guards",
      "items": [
        "The pick launch turns coord and gripper motion on for this process",
        "The driver refuses a pose with no inverse-kinematics solution",
        "A live joint inside the 2 degree limit margin stops the move",
        "An empty note-reader URL falls back to local Tesseract"
      ]
    }
  ]
